FROM continuumio/anaconda3

LABEL maintainer="Iorimiya <iorimiya.vina@gmail.com>"
LABEL version="1.1.0"
LABEL description="Movie Box Office Predictor Compute Node (CPU version)"

RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libfontconfig1 \
    libcups2 \
    libxdamage1 \
    libxcomposite1 \
    libxrandr2 \
    libasound2 \
    libatk1.0-0 \
    libgtk-3-0 \
    libgdk-pixbuf2.0-0 \
    libxkbcommon0 \
    libxss1 \
    && rm -rf /var/lib/apt/lists/*

ARG USERNAME=user
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && apt-get update \
    && apt-get install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && chown -R $USERNAME:$USER_GID /opt/conda

RUN mkdir -p /app && chown $USERNAME:$USER_GID /app

USER $USERNAME

WORKDIR /app

# Path is relative to the build context (project root)
COPY environments/compute-cpu/requirements.yaml /tmp/requirements.yaml

RUN conda config --set remote_read_timeout_secs 600.0 && \
    conda config --set remote_connect_timeout_secs 60.0 && \
    conda config --set remote_max_retries 5

RUN conda env create -n compute_env -f /tmp/requirements.yaml && \
    conda clean -afy

ENV PATH="/opt/conda/envs/compute_env/bin:$PATH"

ENV SHELL="/bin/bash"

ENTRYPOINT ["conda", "run", "--no-capture-output", "-n", "compute_env"]
CMD ["python", "src/web_api/app.py"]

